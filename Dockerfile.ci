FROM ubuntu:xenial

RUN set -eux \
    && apt-get update \
    && apt-get install --no-install-recommends -y -q \
        wget \
        g++ \
        make \
        cmake \
        ninja-build \
        fonts-freefont-ttf \
        libboost-thread-dev \
        libboost-system-dev \
        libboost-filesystem-dev \
        libboost-regex-dev \
        libopenexr-dev \
        libzlcore-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libfreetype6-dev \
        libopencolorio-dev \
    && rm -rf /var/lib/apt/lists/*

ENV GO_VER=1.24.0

RUN apt-get update && apt-get install --no-install-recommends -y -q \
    wget \
    ca-certificates \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && wget --no-check-certificate https://go.dev/dl/go${GO_VER}.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go${GO_VER}.linux-amd64.tar.gz \
    && rm go${GO_VER}.linux-amd64.tar.gz

ENV OIIO_VER=1.6.18

# Download and extract in a deterministic way: capture the top-level dir and rename it.
RUN set -eux \
    && cd /home \
    && wget -q -O oiio.tar.gz "https://github.com/OpenImageIO/oiio/archive/Release-${OIIO_VER}.tar.gz" \
    && EXTRACTED_DIR=$(tar -tzf oiio.tar.gz | head -1 | cut -f1 -d"/") \
    && tar -xzf oiio.tar.gz \
    && rm -f oiio.tar.gz \
    && echo "extracted: $EXTRACTED_DIR" \
    && test -n "$EXTRACTED_DIR" \
    && mv "$EXTRACTED_DIR" "oiio-Release-${OIIO_VER}" \
    && ls -la /home/oiio-Release-${OIIO_VER}

WORKDIR /home/oiio-Release-${OIIO_VER}

RUN set -eux \
    && NCPU=$(grep -c '^processor' /proc/cpuinfo || echo 1) \
    && JOBS=$((NCPU*2+1)) \
    && make -j${JOBS} \
        MYCC=gcc MYCXX=g++ \
        USE_NINJA=1 \
        USE_CPP11=1 \
        USE_OPENGL=0 USE_QT=0 USE_PYTHON=0 USE_PYTHON3=0 \
        OIIO_BUILD_TOOLS=0 OIIO_BUILD_TESTS=0 \
        VERBOSE=1 \
        EXTRA_CPP_ARGS="-Wno-error"

ENV PATH=/usr/local/go/bin:$PATH
ENV CGO_CXXFLAGS="-I/home/oiio-Release-${OIIO_VER}/dist/linux64/include"
ENV CGO_LDFLAGS="-L/home/oiio-Release-${OIIO_VER}/dist/linux64/lib"
ENV LD_LIBRARY_PATH="/home/oiio-Release-${OIIO_VER}/dist/linux64/lib"

WORKDIR /workdir

CMD ["go", "test", "-count", "1", "-v"]